# ---- Crypto Hunter process settings (copy to .env and `set -a; . ./.env; set +a`) ----
# MEXC API credentials are NOT put here. Enter them once in the dashboard Settings panel;
# they are encrypted with CH_MASTER_KEY (Fernet) and stored in the SQLite database.

# Fernet master key used to encrypt the stored API credentials.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If omitted, a key is generated once and written to $CH_DATA_DIR/.master_key (chmod 600).
CH_MASTER_KEY=

# Protect the dashboard + API with a bearer token (strongly recommended when exposed beyond localhost).
# Open the UI as  http://host:8080/?token=<value>
CH_DASHBOARD_TOKEN=

CH_HOST=0.0.0.0
CH_PORT=8080
CH_DATA_DIR=data
CH_DB_PATH=data/crypto_hunter.sqlite
CH_CONFIG=config.yaml
CH_LOG_LEVEL=INFO
CH_LOG_FILE=logs/crypto_hunter.log
